# ── Server ──────────────────────────────────────────────
PORT=3001

# ── Admin API ────────────────────────────────────────────
# Secret key required in x-api-key header for all /api/* routes.
# Leave blank to disable the check (not recommended for production).
ADMIN_API_KEY=change-me-to-a-random-secret

# ── Facebook App ─────────────────────────────────────────
# Any secret string you choose when registering the webhook on Facebook.
FB_VERIFY_TOKEN=my-secret-verify-token

# Page Access Token with leads_retrieval (or ads_management) permission.
# Get this from: Facebook Developer App → your app → Messenger/Pages settings.
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

EMAIL_FROM_NAME=LiveAHome Leads
